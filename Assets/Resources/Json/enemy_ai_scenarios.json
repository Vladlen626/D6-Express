{
  "wb_d1m1_safe_finish_straight": {
    "mode": "scripted",
    "strict_validation": true,
    "on_mismatch": "fail_scenario",
    "target_score": 2000,
    "enemy_setup": {
      "use_modifiers": false,
      "dice_in_hand": ["default","default","default","default","default","default"]
    },
    "turns": [
      {
        "steps": [
          { "action": "roll", "forced_values": [5,5,5,2,3,4], "save_unbanked_indexes": [0,1,2] },
          { "action": "pass" }
        ]
      },
      {
        "steps": [
          { "action": "roll", "forced_values": [1,5,2,3,4,6], "save_unbanked_indexes": [0,1] },
          { "action": "pass" }
        ]
      },
      {
        "steps": [
          { "action": "roll", "forced_values": [1,2,3,4,6,5], "save_unbanked_indexes": [0] },
          { "action": "roll", "forced_values": [2,2,2,5,3], "save_unbanked_indexes": [0,1,2,3] },
          { "action": "pass" }
        ]
      },
      {
        "steps": [
          { "action": "roll", "forced_values": [4,4,4,1,5,2], "save_unbanked_indexes": [0,1,2,3,4] },
          { "action": "pass" }
        ]
      },
      {
        "steps": [
          { "action": "roll", "forced_values": [6,6,6,1,2,3], "save_unbanked_indexes": [0,1,2,3] },
          { "action": "pass" }
        ]
      }
    ],
    "expected_result": {
      "completed_in_enemy_turns": 5,
      "enemy_final_banked_score": 2250,
      "enemy_reaches_target": true
    }
  },

